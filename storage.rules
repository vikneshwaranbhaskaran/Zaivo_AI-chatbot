rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
  
    function isAdmin() {
      // Storage doesn't have direct access to Firestore data to easily check adminRoles collection without a custom claim
      // As a workaround, we assume any write requires authentication. For true security, custom claims should be set via Cloud Functions.
      // But for this frontend-only implementation, we'll check if auth is present for write.
      // Or we can rely on standard Firebase Auth + Firebase Console for admin rules if we don't have custom claims.
      // Since it's a frontend-only app and we want to prevent non-admins from uploading, 
      // ideally we should use custom claims. Without them, we can just allow read if authenticated, 
      // and only allow write if request.auth != null. 
      // Let's implement a tight read rule and a write rule that requires auth at least.
      return request.auth != null; 
    }
    
    match /videos/{videoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; // For a frontend-only app without custom claims, any authenticated user *could* theoretically write to storage if they know the endpoint, but we restrict it in the UI. A stronger approach uses custom claims.
    }
    
    match /documents/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
